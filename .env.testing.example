APP_NAME="Nation Health Tests"
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Each active DB_CONNECTION starts a separate block. Only the first is used.
# Keep all settings for that connection together; commented blocks are ignored.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=testing
DB_USERNAME=postgres
DB_PASSWORD=
DATABASE_URL=

# MySQL alternative (uncomment this block and comment out PostgreSQL to select it).
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=testing
# DB_USERNAME=root
# DB_PASSWORD=

# MariaDB alternative (also supported via DB_CONNECTION=mysql).
# DB_CONNECTION=mariadb
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=testing
# DB_USERNAME=root
# DB_PASSWORD=

BCRYPT_ROUNDS=4
CACHE_DRIVER=array
FILESYSTEM_DISK=local
MAIL_MAILER=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
SESSION_SECURE_COOKIE=false
TELESCOPE_ENABLED=false

EHEALTH_API_URL=https://ehealth.invalid
EHEALTH_SEED_ICD10=false
CIPHER_API_URL=https://cipher.invalid
